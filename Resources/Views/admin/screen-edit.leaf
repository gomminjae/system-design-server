<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>통스통스 · 화면 편집</title>
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
  #extend("admin/styles")
  <style>
    .content { max-width: 1240px; }
    .layout { display: flex; gap: 32px; }
    .editor { flex: 1; min-width: 0; }
    .preview-wrap { width: 375px; flex-shrink: 0; position: sticky; top: 32px; align-self: flex-start; }

    .toolbar { display: flex; gap: 8px; margin: 4px 0 20px; align-items: center; }
    .toolbar .spacer { flex: 1; }

    /* 버튼 — JS가 생성하는 btn-small 계열 (자체 완결형) */
    .btn-small {
      display: inline-flex; align-items: center; justify-content: center; gap: 5px;
      padding: 8px 13px; border-radius: 10px; border: 1px solid transparent;
      font-family: inherit; font-size: 13px; font-weight: 600; cursor: pointer;
      background: var(--border-soft); color: var(--text-sub); transition: opacity 0.12s, background 0.12s;
    }
    .btn-small:hover { background: var(--border); }
    .btn-small:active { opacity: 0.85; }
    .btn-small.btn-primary { background: var(--blue); color: #fff; }
    .btn-small.btn-primary:hover { background: var(--blue-dark); }
    .btn-small.btn-success { background: var(--green); color: #fff; }
    .btn-small.btn-danger { background: var(--red); color: #fff; }

    .section-item {
      background: var(--surface); border: 1px solid var(--border); border-radius: 16px;
      padding: 14px 16px; margin: 10px 0; display: flex; align-items: center; gap: 14px;
      box-shadow: var(--shadow);
    }
    .section-item .handle { cursor: grab; font-size: 18px; color: var(--text-cap); user-select: none; }
    .section-item .handle:active { cursor: grabbing; }
    .section-item .info { flex: 1; min-width: 0; }
    .section-item .info h4 { margin: 0 0 3px; font-size: 15px; font-weight: 700; }
    .section-item .info p { margin: 0; color: var(--text-cap); font-size: 13px; font-weight: 500; }
    .section-item .actions { display: flex; gap: 6px; }
    .sortable-ghost { opacity: 0.4; }

    .type-picker {
      display: flex; gap: 8px; flex-wrap: wrap; margin: 14px 0;
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 16px; padding: 16px;
    }
    .type-picker-label { width: 100%; font-size: 12px; font-weight: 700; color: var(--text-cap); margin: 6px 0 2px; }
    .type-picker-label:first-child { margin-top: 0; }
    .type-btn {
      padding: 9px 15px; border: 1px solid var(--border); border-radius: 10px;
      cursor: pointer; font-size: 14px; font-weight: 600; background: var(--surface);
      transition: border-color 0.12s, background 0.12s;
    }
    .type-btn:hover { border-color: var(--blue); background: var(--blue-bg); color: var(--blue); }

    .modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 100; }
    .modal.show { display: flex; align-items: center; justify-content: center; }
    .modal-body {
      background: var(--surface); border-radius: 20px; padding: 28px;
      width: 90%; max-width: 520px; max-height: 84vh; overflow-y: auto; box-shadow: var(--shadow-pop);
    }
    .modal-body h3 { margin: 0 0 18px; font-size: 19px; font-weight: 700; }
    .field { margin-bottom: 14px; }
    .field label { display: block; font-size: 13px; font-weight: 600; color: var(--text-sub); margin-bottom: 6px; }
    .field input, .field select, .field textarea { width: 100%; }
    .field textarea { height: 80px; resize: vertical; }
    .slide-card { border: 1px solid var(--border); border-radius: 12px; padding: 14px; margin-bottom: 10px; background: var(--bg); }

    /* ===== 프리뷰 (디바이스 목업) ===== */
    .preview-label { font-size: 13px; font-weight: 700; color: var(--text-cap); margin-bottom: 12px; text-align: center; }
    .phone { width: 375px; height: 720px; border: 8px solid #191f28; border-radius: 44px; overflow: hidden; background: #f8f9fa; position: relative; box-shadow: var(--shadow-pop); }
    .phone-notch { width: 130px; height: 30px; background: #191f28; border-radius: 0 0 18px 18px; margin: 0 auto; }
    .phone-screen { height: calc(100% - 30px); overflow-y: auto; }
    .phone-screen::-webkit-scrollbar { display: none; }

    .pv-carousel { position: relative; height: 200px; overflow: hidden; }
    .pv-carousel .slide { height: 200px; background: linear-gradient(135deg, #3182f6 0%, #1b64da 100%); display: flex; flex-direction: column; justify-content: flex-end; padding: 20px; color: #fff; }
    .pv-carousel .slide img { position: absolute; top: 0; left: 0; width: 100%; height: 200px; object-fit: cover; }
    .pv-carousel .slide-text { position: relative; z-index: 1; }
    .pv-carousel .slide h3 { margin: 0; font-size: 20px; font-weight: 700; text-shadow: 0 1px 4px rgba(0,0,0,0.3); }
    .pv-carousel .slide p { margin: 4px 0 0; font-size: 14px; opacity: 0.9; }
    .pv-carousel .dots { position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%); display: flex; gap: 6px; z-index: 2; }
    .pv-carousel .dot { width: 6px; height: 6px; border-radius: 50%; background: rgba(255,255,255,0.5); }
    .pv-carousel .dot.active { background: #fff; }

    .pv-header { padding: 18px 16px 8px; display: flex; justify-content: space-between; align-items: flex-start; }
    .pv-header h4 { margin: 0; font-size: 17px; font-weight: 700; }
    .pv-header .sub { margin: 2px 0 0; font-size: 13px; color: var(--text-cap); }
    .pv-header span { font-size: 13px; font-weight: 600; color: var(--blue); }

    .pv-hscroll { display: flex; gap: 10px; overflow-x: auto; padding: 0 16px 12px; }
    .pv-hscroll::-webkit-scrollbar { display: none; }
    .pv-card { width: 120px; flex-shrink: 0; }
    .pv-card .thumb { width: 120px; height: 120px; background: var(--border); border-radius: 14px; display: flex; align-items: center; justify-content: center; color: var(--text-cap); font-size: 24px; overflow: hidden; }
    .pv-card .thumb img { width: 100%; height: 100%; object-fit: cover; }
    .pv-card h5 { margin: 7px 0 2px; font-size: 13px; font-weight: 600; }
    .pv-card p { margin: 0; font-size: 11px; color: var(--text-cap); }
    .pv-card .badge { display: inline-block; background: var(--red); color: #fff; font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 6px; margin-top: 4px; }

    .pv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 0 16px 12px; }
    .pv-grid .pv-card { width: auto; }
    .pv-grid .thumb { width: 100%; height: 104px; }

    .pv-chips { display: flex; gap: 8px; padding: 10px 16px; overflow-x: auto; }
    .pv-chips::-webkit-scrollbar { display: none; }
    .pv-chip { padding: 7px 15px; border-radius: 18px; font-size: 13px; font-weight: 600; white-space: nowrap; }
    .pv-chip.active { background: #191f28; color: #fff; }
    .pv-chip.inactive { background: var(--border-soft); color: var(--text-sub); }

    .pv-divider { margin: 0; border: none; }
    .pv-cta { padding: 14px 16px; }
    .pv-cta .btn { display: block; width: 100%; padding: 15px; border-radius: 14px; font-size: 16px; font-weight: 700; text-align: center; }
    .pv-cta .btn.primary { background: var(--blue); color: #fff; }
    .pv-cta .btn.secondary { background: var(--border-soft); color: var(--text); }

    .pv-detail { padding: 18px 16px; text-align: center; }
    .pv-detail .thumb-lg { width: 100%; height: 200px; background: var(--border); border-radius: 14px; margin-bottom: 16px; display: flex; align-items: center; justify-content: center; color: var(--text-cap); font-size: 32px; overflow: hidden; }
    .pv-detail .thumb-lg img { width: 100%; height: 100%; object-fit: cover; }
    .pv-detail h3 { margin: 0 0 4px; font-size: 20px; font-weight: 700; }
    .pv-detail .sub { color: var(--text-sub); font-size: 14px; margin: 0 0 8px; }
    .pv-detail .stats { color: var(--text-cap); font-size: 13px; margin: 0 0 20px; }

    .pv-tong-card { margin: 0 16px 12px; border: 1px solid var(--border); border-radius: 14px; padding: 12px; display: flex; gap: 12px; align-items: center; }
    .pv-tong-card .thumb-sm { width: 60px; height: 60px; background: var(--border); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px; overflow: hidden; flex-shrink: 0; }
    .pv-tong-card .thumb-sm img { width: 100%; height: 100%; object-fit: cover; }
    .pv-tong-card h5 { margin: 0 0 2px; font-size: 14px; font-weight: 700; }
    .pv-tong-card p { margin: 0; font-size: 12px; color: var(--text-cap); }
    .pv-tong-card .badge { display: inline-block; background: var(--red); color: #fff; font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 6px; }

    .pv-empty { padding: 48px 16px; text-align: center; color: var(--text-cap); font-size: 14px; }

    @media (max-width: 980px) {
      .layout { flex-direction: column; }
      .preview-wrap { width: 100%; position: static; display: flex; flex-direction: column; align-items: center; }
    }
  </style>
</head>
<body>
  <div class="app">
    <aside class="sidebar">
      <div class="brand"><span class="logo">🫙</span> 통스통스</div>
      <a class="nav-item" href="/admin"><span class="ico">📥</span> 심사 목록</a>
      <a class="nav-item active" href="/admin/screens"><span class="ico">📱</span> 화면 관리</a>
      <a class="nav-item" href="/admin/card-news"><span class="ico">🗞</span> 카드뉴스</a>
    </aside>

    <main class="content">
      <p class="crumb"><a href="/admin/screens">화면 관리</a> › <b id="screen-title-nav">편집</b></p>
      <div class="layout">
        <div class="editor">
          <div class="page-head">
            <h1 id="page-title">화면 편집</h1>
            <div class="toolbar" style="margin:0;">
              <span class="badge" id="publish-badge">로딩중</span>
              <button class="btn btn-sm btn-success" id="publish-btn" onclick="togglePublish()">발행</button>
              <button class="btn btn-sm btn-primary" onclick="save()">저장</button>
            </div>
          </div>

          <div id="section-list"></div>

          <div style="margin-top: 14px;">
            <button class="btn btn-primary" onclick="showAddSection()">+ 섹션 추가</button>
          </div>
          <div id="add-section-area" style="display:none;">
            <div class="type-picker">
              <div class="type-picker-label">섹션</div>
              <div class="type-btn" onclick="addSection('carousel')">🎠 캐러셀</div>
              <div class="type-btn" onclick="addSection('tong_list')">📋 통 리스트</div>
              <div class="type-btn" onclick="addSection('category_chips')">🏷 카테고리</div>
              <div class="type-btn" onclick="addSection('tong_detail')">📄 통 상세</div>
              <div class="type-picker-label">공통 컴포넌트</div>
              <div class="type-btn" onclick="addSection('section_header')">📌 헤더</div>
              <div class="type-btn" onclick="addSection('divider')">➖ 구분선</div>
              <div class="type-btn" onclick="addSection('cta_button')">🔘 CTA 버튼</div>
              <div class="type-btn" onclick="addSection('tong_card')">🃏 통 카드</div>
            </div>
          </div>
        </div>

        <div class="preview-wrap">
          <div class="preview-label">실시간 미리보기</div>
          <div class="phone">
            <div class="phone-notch"></div>
            <div class="phone-screen" id="preview"></div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <div class="modal" id="edit-modal">
    <div class="modal-body">
      <h3 id="modal-title">섹션 편집</h3>
      <div id="modal-fields"></div>
      <div style="display:flex; gap:8px; margin-top:20px;">
        <button class="btn btn-primary" onclick="saveSection()">확인</button>
        <button class="btn btn-ghost" onclick="closeModal()">취소</button>
      </div>
    </div>
  </div>

  <script>
    const screenId = '#(screenId)';
    const AUTH = 'Basic ' + btoa('#(adminUser):#(adminPassword)');
    const headers = { 'Content-Type': 'application/json', 'Authorization': AUTH };
    let screenData = null;
    let sections = [];
    let editingIndex = -1;

    const TYPE_LABELS = {
      carousel: '🎠 캐러셀', tong_list: '📋 통 리스트', category_chips: '🏷 카테고리',
      tong_detail: '📄 통 상세', section_header: '📌 헤더', divider: '➖ 구분선',
      cta_button: '🔘 CTA 버튼', tong_card: '🃏 통 카드'
    };

    async function load() {
      const res = await fetch('/admin/api/screens/' + screenId, { headers });
      screenData = (await res.json()).data;
      sections = screenData.sections || [];
      document.getElementById('page-title').textContent = screenData.title + ' 편집';
      document.getElementById('screen-title-nav').textContent = screenData.title;
      updatePublishBadge(screenData.isPublished);
      render();
    }

    function updatePublishBadge(pub) {
      const b = document.getElementById('publish-badge');
      b.textContent = pub ? '발행중' : '미발행';
      b.className = 'badge ' + (pub ? 'published' : 'draft');
      document.getElementById('publish-btn').textContent = pub ? '비발행' : '발행';
    }

    function render() {
      const list = document.getElementById('section-list');
      list.innerHTML = sections.map((s, i) => `
        <div class="section-item" data-index="${i}">
          <span class="handle">☰</span>
          <div class="info"><h4>${TYPE_LABELS[s.type] || s.type}</h4><p>${summary(s)}</p></div>
          <div class="actions">
            <button class="btn-small" onclick="editSection(${i})">편집</button>
            <button class="btn-small btn-danger" onclick="removeSection(${i})">삭제</button>
          </div>
        </div>`).join('');
      new Sortable(list, { handle: '.handle', ghostClass: 'sortable-ghost', animation: 200,
        onEnd: e => { sections.splice(e.newIndex, 0, sections.splice(e.oldIndex, 1)[0]); renderPreview(); }
      });
      renderPreview();
    }

    function summary(s) {
      const d = s.data || {};
      switch (s.type) {
        case 'carousel': return (d.slides||[]).length + '장 · ' + (d.duration||3000) + 'ms';
        case 'tong_list': return (d.headerTitle||'(제목 없음)') + ' · ' + (d.categorySlug ? ('동적:'+d.categorySlug) : (d.layout||'grid'));
        case 'category_chips': return 'DB 자동 (카테고리 전체)';
        case 'tong_detail': return d.title || '(제목 없음)';
        case 'section_header': return d.headerTitle || '(제목 없음)';
        case 'divider': return (d.height||8) + 'px';
        case 'cta_button': return d.buttonLabel || '(라벨 없음)';
        case 'tong_card': return d.title || '(제목 없음)';
        default: return '';
      }
    }

    // ===== 프리뷰 =====
    function renderPreview() {
      const pv = document.getElementById('preview');
      if (!sections.length) { pv.innerHTML = '<div class="pv-empty">섹션을 추가하세요</div>'; return; }
      pv.innerHTML = sections.map(pvSection).join('');
    }

    function pvSection(s) {
      const d = s.data || {};
      switch (s.type) {
        case 'carousel': return pvCarousel(d);
        case 'tong_list': return pvTongList(d);
        case 'category_chips': return pvChips(d);
        case 'tong_detail': return pvDetail(d);
        case 'section_header': return pvHeader(d);
        case 'divider': return `<div class="pv-divider" style="height:${d.height||8}px;background:${d.color||'#f0f0f0'}"></div>`;
        case 'cta_button': return `<div class="pv-cta"><div class="btn ${d.buttonStyle||'primary'}">${d.buttonLabel||'버튼'}</div></div>`;
        case 'tong_card': return pvTongCard(d);
        default: return '';
      }
    }

    function pvCarousel(d) {
      const slides = d.slides && d.slides.length ? d.slides : [{ title: '배너 제목', subtitle: '부제목' }];
      const first = slides[0];
      const dots = slides.map((_,i) => `<div class="dot ${i===0?'active':''}"></div>`).join('');
      return `<div class="pv-carousel">
        <div class="slide">${first.imageURL ? `<img src="${first.imageURL}">` : ''}
          <div class="slide-text"><h3>${first.title||''}</h3>${first.subtitle?`<p>${first.subtitle}</p>`:''}</div>
        </div>
        <div class="dots">${dots}</div>
      </div>`;
    }

    function pvHeader(d) {
      return `<div class="pv-header"><div><h4>${d.headerTitle||'제목'}</h4>${d.headerSubtitle?`<p class="sub">${d.headerSubtitle}</p>`:''}</div>${d.showMoreText?`<span>${d.showMoreText} ›</span>`:''}</div>`;
    }

    function pvTongList(d) {
      const items = d.items && d.items.length ? d.items : [{title:'샘플 1'},{title:'샘플 2'},{title:'샘플 3'}];
      const header = pvHeader(d);
      const cards = items.map(it => `<div class="pv-card">
        <div class="thumb">${it.thumbnailURL?`<img src="${it.thumbnailURL}">`:''}</div>
        <h5>${it.title||''}</h5><p>${it.subtitle||''}</p>
        ${it.badge?`<span class="badge">${it.badge}</span>`:''}
      </div>`).join('');
      return d.layout === 'horizontal_scroll'
        ? `${header}<div class="pv-hscroll">${cards}</div>`
        : `${header}<div class="pv-grid">${cards}</div>`;
    }

    function pvChips(d) {
      const chips = d.chips && d.chips.length ? d.chips : [{id:'all',label:'전체'}];
      return `<div class="pv-chips">${chips.map(c => `<div class="pv-chip ${c.id===(d.selectedId||chips[0].id)?'active':'inactive'}">${c.label}</div>`).join('')}</div>`;
    }

    function pvDetail(d) {
      return `<div class="pv-detail">
        <div class="thumb-lg">${d.thumbnailURL?`<img src="${d.thumbnailURL}">`:''}</div>
        <h3>${d.title||'제목'}</h3><p class="sub">${d.subtitle||''}</p><p class="stats">${d.stats||''}</p>
        <div class="btn primary" style="display:block;width:100%;padding:15px;background:#3182f6;color:#fff;border-radius:14px;font-size:16px;font-weight:700;text-align:center;">${d.buttonText||'시작하기'}</div>
        ${d.shareText?`<span style="display:block;margin-top:12px;color:#3182f6;font-size:14px;">${d.shareText}</span>`:''}
      </div>`;
    }

    function pvTongCard(d) {
      return `<div class="pv-tong-card">
        <div class="thumb-sm">${d.thumbnailURL?`<img src="${d.thumbnailURL}">`:''}</div>
        <div><h5>${d.title||'제목'}</h5><p>${d.subtitle||''}</p>${d.badge?`<span class="badge">${d.badge}</span>`:''}</div>
      </div>`;
    }

    // ===== 에디터 =====
    function showAddSection() { document.getElementById('add-section-area').style.display = 'block'; }
    function addSection(type) {
      sections.push({ id: crypto.randomUUID(), type, data: {}, action: null });
      document.getElementById('add-section-area').style.display = 'none';
      render(); editSection(sections.length - 1);
    }
    function removeSection(i) { if (confirm('삭제하시겠습니까?')) { sections.splice(i,1); render(); } }

    function editSection(i) {
      editingIndex = i;
      const s = sections[i], d = s.data||{}, a = s.action||{};
      document.getElementById('modal-title').textContent = (TYPE_LABELS[s.type]||s.type) + ' 편집';
      let h = '';
      switch (s.type) {
        case 'carousel':
          h = `<div id="slides-container">${(d.slides||[]).map((sl,si) => slideCard(si, sl)).join('')}</div>
            <button type="button" class="btn-small btn-primary" onclick="addSlideCard()" style="margin:8px 0 16px;">+ 슬라이드 추가</button>
            ${field('duration','자동 슬라이드 (ms)', d.duration||3000)}`;
          break;
        case 'tong_list':
          h = `${field('headerTitle','헤더 제목',d.headerTitle)}${field('headerSubtitle','헤더 부제목',d.headerSubtitle)}${sel('layout','레이아웃',d.layout,['horizontal_scroll','grid'])}${field('categorySlug','동적: 카테고리 slug (비우면 수동 items)',d.categorySlug)}${field('limit','동적: 최대 개수 (기본 10)',d.limit)}${field('showMoreText','더보기 텍스트',d.showMoreText)}${field('actionRoute','더보기 경로',a.route)}`;
          break;
        case 'category_chips':
          h = `<p style="font-size:13px;color:var(--text-sub);background:var(--blue-bg);padding:10px 12px;border-radius:10px;margin:0 0 14px;">🔗 칩 목록은 서버가 카테고리 DB에서 자동으로 채웁니다. 수동 입력이 필요 없어요.</p>${field('selectedId','기본 선택 (비우면 전체)',d.selectedId)}`;
          break;
        case 'tong_detail':
          h = `${field('tongId','통 ID',d.tongId)}${field('title','제목',d.title)}${field('subtitle','부제목',d.subtitle)}${field('thumbnailURL','썸네일 URL',d.thumbnailURL)}${field('stats','통계',d.stats)}${field('buttonText','버튼 텍스트',d.buttonText)}${field('shareText','공유 텍스트',d.shareText)}${field('bundleURL','번들 URL',d.bundleURL)}`;
          break;
        case 'section_header':
          h = `${field('headerTitle','제목',d.headerTitle)}${field('headerSubtitle','부제목',d.headerSubtitle)}${field('showMoreText','더보기 텍스트',d.showMoreText)}${field('actionRoute','더보기 경로',a.route)}`;
          break;
        case 'divider':
          h = `${field('height','높이 (px)',d.height||8)}${field('color','색상',d.color||'#f0f0f0')}`;
          break;
        case 'cta_button':
          h = `${field('buttonLabel','라벨',d.buttonLabel)}${sel('buttonStyle','스타일',d.buttonStyle,['primary','secondary'])}${field('actionRoute','이동 경로',a.route)}`;
          break;
        case 'tong_card':
          h = `${field('tongId','통 ID',d.tongId)}${field('title','제목',d.title)}${field('subtitle','부제목',d.subtitle)}${field('thumbnailURL','썸네일 URL',d.thumbnailURL)}${field('badge','뱃지',d.badge)}`;
          break;
      }
      document.getElementById('modal-fields').innerHTML = h;
      document.getElementById('edit-modal').classList.add('show');
    }

    function field(n,l,v) { return `<div class="field"><label>${l}</label><input name="${n}" value="${v||''}"></div>`; }
    function textarea(n,l,v) { return `<div class="field"><label>${l}</label><textarea name="${n}">${v||''}</textarea></div>`; }

    function slideCard(idx, sl) {
      sl = sl || { imageURL: '', title: '', subtitle: '' };
      return `<div class="slide-card" data-idx="${idx}">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
          <strong style="font-size:13px;">슬라이드 ${idx+1}</strong>
          <button type="button" class="btn-small btn-danger" onclick="removeSlideCard(this)" style="padding:4px 9px;font-size:11px;">삭제</button>
        </div>
        <div class="field"><label>이미지 URL</label><input data-field="imageURL" value="${sl.imageURL||''}"></div>
        <div class="field"><label>제목</label><input data-field="title" value="${sl.title||''}"></div>
        <div class="field"><label>부제목</label><input data-field="subtitle" value="${sl.subtitle||''}"></div>
      </div>`;
    }
    function addSlideCard() {
      const c = document.getElementById('slides-container');
      const idx = c.querySelectorAll('.slide-card').length;
      c.insertAdjacentHTML('beforeend', slideCard(idx, null));
    }
    function removeSlideCard(btn) {
      btn.closest('.slide-card').remove();
      document.querySelectorAll('.slide-card').forEach((el,i) => el.querySelector('strong').textContent = '슬라이드 '+(i+1));
    }
    function sel(n,l,v,opts) { return `<div class="field"><label>${l}</label><select name="${n}">${opts.map(o=>`<option value="${o}" ${o===v?'selected':''}>${o}</option>`).join('')}</select></div>`; }
    function val(n) { const e = document.querySelector(`[name="${n}"]`); return e ? e.value.trim() : ''; }

    function saveSection() {
      const s = sections[editingIndex], d = s.data || {};
      switch (s.type) {
        case 'carousel':
          const slideEls = document.querySelectorAll('.slide-card');
          const slides = Array.from(slideEls).map(el => ({
            imageURL: el.querySelector('[data-field="imageURL"]').value.trim(),
            title: el.querySelector('[data-field="title"]').value.trim() || null,
            subtitle: el.querySelector('[data-field="subtitle"]').value.trim() || null,
            action: null
          }));
          s.data = { slides, duration: parseInt(val('duration'))||3000 };
          break;
        case 'tong_list':
          s.data = { headerTitle: val('headerTitle'), headerSubtitle: val('headerSubtitle'), layout: val('layout'), showMoreText: val('showMoreText'), categorySlug: val('categorySlug'), limit: parseInt(val('limit')) || null, items: d.items||[] };
          s.action = val('actionRoute') ? { type: 'navigate', route: val('actionRoute') } : null;
          break;
        case 'category_chips':
          // 칩은 서버가 카테고리 DB로 채운다. 기본 선택만 저장.
          s.data = { selectedId: val('selectedId') };
          break;
        case 'tong_detail':
          s.data = { tongId: val('tongId'), title: val('title'), subtitle: val('subtitle'), thumbnailURL: val('thumbnailURL'), stats: val('stats'), buttonText: val('buttonText'), shareText: val('shareText'), bundleURL: val('bundleURL') };
          s.action = val('tongId') ? { type: 'open_webview', tongId: val('tongId'), bundleURL: val('bundleURL') } : null;
          break;
        case 'section_header':
          s.data = { headerTitle: val('headerTitle'), headerSubtitle: val('headerSubtitle'), showMoreText: val('showMoreText') };
          s.action = val('actionRoute') ? { type: 'navigate', route: val('actionRoute') } : null;
          break;
        case 'divider':
          s.data = { height: parseInt(val('height'))||8, color: val('color')||'#f0f0f0' };
          break;
        case 'cta_button':
          s.data = { buttonLabel: val('buttonLabel'), buttonStyle: val('buttonStyle') };
          s.action = val('actionRoute') ? { type: 'navigate', route: val('actionRoute') } : null;
          break;
        case 'tong_card':
          s.data = { tongId: val('tongId'), title: val('title'), subtitle: val('subtitle'), thumbnailURL: val('thumbnailURL'), badge: val('badge') };
          s.action = val('tongId') ? { type: 'open_tong', tongId: val('tongId') } : null;
          break;
      }
      closeModal(); render();
    }

    function closeModal() { document.getElementById('edit-modal').classList.remove('show'); editingIndex = -1; }

    async function save() {
      await fetch('/admin/api/screens', { method: 'POST', headers, body: JSON.stringify({ screenId, title: screenData.title, sections }) });
      alert('저장되었습니다.');
    }
    async function togglePublish() {
      const res = await fetch('/admin/api/screens/' + screenId + '/publish', { method: 'PUT', headers });
      updatePublishBadge((await res.json()).data.isPublished);
    }

    load();
  </script>
</body>
</html>
