<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>통스통스 · 심사</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, sans-serif; max-width: 720px; margin: 24px auto; padding: 0 16px; color: #222; }
    h1 { font-size: 22px; }
    .card { border: 1px solid #e4e4e4; border-radius: 12px; padding: 16px; margin: 12px 0; }
    .card h3 { margin: 0 0 4px; }
    .meta { color: #999; font-size: 13px; margin: 0 0 12px; }
    button { padding: 7px 16px; border-radius: 8px; border: 0; cursor: pointer; font-size: 14px; }
    .approve { background: #2ecc71; color: #fff; }
    .reject { background: #e74c3c; color: #fff; }
    form { display: inline; }
    input { padding: 6px 9px; border: 1px solid #ddd; border-radius: 8px; }
    .empty { color: #888; }
  </style>
</head>
<body>
  <h1>🫙 심사 큐 (#count(tongs))</h1>
  #if(count(tongs) == 0):
    <p class="empty">대기 중인 통이 없어요.</p>
  #endif
  #for(tong in tongs):
    <div class="card">
      <h3>#(tong.title)</h3>
      <p class="meta">#(tong.type) · #(tong.category) · v#(tong.version) · #(tong.ageRating)</p>
      <form method="post" action="/admin/tongs/#(tong.id)/approve">
        <button class="approve" type="submit">승인</button>
      </form>
      <form method="post" action="/admin/tongs/#(tong.id)/reject">
        <input name="reason" placeholder="반려 사유" required>
        <button class="reject" type="submit">반려</button>
      </form>
    </div>
  #endfor
</body>
</html>
