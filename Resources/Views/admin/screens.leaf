<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>통스통스 · 화면 관리</title>
  #extend("admin/styles")
  <style>
    .create-card { display: none; }
    .create-card.show { display: block; }
    .create-card .field { margin-bottom: 10px; }
    .create-card label { display: block; font-size: 13px; font-weight: 600; color: var(--text-sub); margin-bottom: 6px; }
    .create-card input { width: 100%; }
    .screen-id { font-size: 17px; font-weight: 700; }
    .screen-id .pin { color: var(--text-cap); font-weight: 600; }
  </style>
</head>
<body>
  <div class="app">
    <aside class="sidebar">
      <div class="brand"><span class="logo">🫙</span> 통스통스</div>
      <a class="nav-item" href="/admin"><span class="ico">📥</span> 심사 목록</a>
      <a class="nav-item active" href="/admin/screens"><span class="ico">📱</span> 화면 관리</a>
      <a class="nav-item" href="/admin/card-news"><span class="ico">🗞</span> 카드뉴스</a>
    </aside>

    <main class="content">
      <div class="page-head">
        <div>
          <h1>화면 관리</h1>
          <p class="sub">앱 SDUI 화면을 만들고 발행해요</p>
        </div>
        <button class="btn btn-primary" onclick="showCreate()">+ 새 화면</button>
      </div>

      <div id="create-form" class="create-card card">
        <div class="field">
          <label>화면 ID</label>
          <input id="new-screen-id" placeholder="예: home">
        </div>
        <div class="field">
          <label>화면 제목</label>
          <input id="new-title" placeholder="예: 홈">
        </div>
        <button class="btn btn-primary" onclick="createScreen()">생성</button>
        <button class="btn btn-ghost" onclick="hideCreate()">취소</button>
      </div>

      <div id="screen-list"></div>
    </main>
  </div>

  <script>
    const headers = { 'Content-Type': 'application/json' };

    async function loadScreens() {
      const res = await fetch('/admin/api/screens', { headers });
      const screens = (await res.json()).data;
      const list = document.getElementById('screen-list');
      if (screens.length === 0) {
        list.innerHTML = '<div class="empty"><span class="emoji">📱</span>등록된 화면이 없어요.</div>';
        return;
      }
      list.innerHTML = screens.map(s => `
        <div class="card row">
          <div>
            <p class="screen-id"><span class="pin">#</span>${s.screenId}</p>
            <p class="meta" style="margin-top:6px;">${s.title} · <span class="badge ${s.isPublished ? 'published' : 'draft'}">${s.isPublished ? '발행중' : '미발행'}</span></p>
          </div>
          <a class="btn btn-outline btn-sm" href="/admin/screens/${s.screenId}/edit">편집</a>
        </div>
      `).join('');
    }

    function showCreate() { document.getElementById('create-form').classList.add('show'); }
    function hideCreate() { document.getElementById('create-form').classList.remove('show'); }

    async function createScreen() {
      const screenId = document.getElementById('new-screen-id').value.trim();
      const title = document.getElementById('new-title').value.trim();
      if (!screenId || !title) return alert('ID와 제목을 입력하세요.');
      await fetch('/admin/api/screens', {
        method: 'POST', headers,
        body: JSON.stringify({ screenId, title, sections: [] })
      });
      location.reload();
    }

    loadScreens();
  </script>
</body>
</html>
