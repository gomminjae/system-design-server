<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>통스통스 · 화면 관리</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, sans-serif; max-width: 720px; margin: 24px auto; padding: 0 16px; color: #222; }
    h1 { font-size: 22px; }
    a { color: #3498db; text-decoration: none; }
    .card { border: 1px solid #e4e4e4; border-radius: 12px; padding: 16px; margin: 12px 0; display: flex; justify-content: space-between; align-items: center; }
    .card h3 { margin: 0 0 4px; }
    .meta { color: #999; font-size: 13px; margin: 0; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 6px; font-size: 12px; font-weight: 600; }
    .badge.published { background: #2ecc71; color: #fff; }
    .badge.draft { background: #bdc3c7; color: #fff; }
    button { padding: 7px 16px; border-radius: 8px; border: 0; cursor: pointer; font-size: 14px; }
    .btn-primary { background: #3498db; color: #fff; }
    .btn-small { padding: 5px 12px; font-size: 13px; }
    .empty { color: #888; }
    .nav { margin-bottom: 16px; font-size: 14px; }
    .nav a { margin-right: 16px; }
  </style>
</head>
<body>
  <div class="nav">
    <a href="/admin">심사 큐</a>
    <a href="/admin/screens"><b>화면 관리</b></a>
  </div>

  <h1>📱 화면 관리</h1>
  <button class="btn-primary" onclick="showCreate()">+ 새 화면</button>

  <div id="create-form" style="display:none; margin: 16px 0;">
    <div class="card" style="flex-direction:column; align-items:stretch;">
      <input id="new-screen-id" placeholder="화면 ID (예: home)" style="padding:8px; border:1px solid #ddd; border-radius:8px; margin-bottom:8px;">
      <input id="new-title" placeholder="화면 제목" style="padding:8px; border:1px solid #ddd; border-radius:8px; margin-bottom:8px;">
      <button class="btn-primary" onclick="createScreen()">생성</button>
    </div>
  </div>

  <div id="screen-list"></div>

  <script>
    const AUTH = 'Basic ' + btoa('#(adminUser):#(adminPassword)');
    const headers = { 'Content-Type': 'application/json', 'Authorization': AUTH };

    async function loadScreens() {
      const res = await fetch('/admin/api/screens', { headers });
      const screens = await res.json();
      const list = document.getElementById('screen-list');
      if (screens.length === 0) {
        list.innerHTML = '<p class="empty">등록된 화면이 없어요.</p>';
        return;
      }
      list.innerHTML = screens.map(s => `
        <div class="card">
          <div>
            <h3>${s.screenId}</h3>
            <p class="meta">${s.title} · <span class="badge ${s.isPublished ? 'published' : 'draft'}">${s.isPublished ? '발행' : '미발행'}</span></p>
          </div>
          <div>
            <a href="/admin/screens/${s.screenId}/edit">편집</a>
          </div>
        </div>
      `).join('');
    }

    function showCreate() {
      document.getElementById('create-form').style.display = 'block';
    }

    async function createScreen() {
      const screenId = document.getElementById('new-screen-id').value.trim();
      const title = document.getElementById('new-title').value.trim();
      if (!screenId || !title) return alert('ID와 제목을 입력하세요.');
      await fetch('/admin/api/screens', {
        method: 'POST', headers,
        body: JSON.stringify({ screenId, title, sections: [] })
      });
      location.reload();
    }

    loadScreens();
  </script>
</body>
</html>
