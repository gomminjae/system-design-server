<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>통스통스 · 심사</title>
  #extend("admin/styles")
  <style>
    .reject-row { display: flex; gap: 8px; align-items: center; }
    .reject-row input { flex: 1; }
    .actions { display: flex; gap: 8px; align-items: center; flex-shrink: 0; }
    .tong-info { min-width: 0; }
    .preview-link { font-size: 13px; font-weight: 600; }
  </style>
</head>
<body>
  <div class="app">
    <aside class="sidebar">
      <div class="brand"><span class="logo">🫙</span> 통스통스</div>
      <a class="nav-item active" href="/admin"><span class="ico">📥</span> 심사 목록</a>
      <a class="nav-item" href="/admin/screens"><span class="ico">📱</span> 화면 관리</a>
    </aside>

    <main class="content">
      <div class="page-head">
        <div>
          <h1>심사 목록</h1>
          <p class="sub">검토 대기 중인 통 #count(tongs)건</p>
        </div>
      </div>

      #if(count(tongs) == 0):
        <div class="empty"><span class="emoji">✅</span>대기 중인 통이 없어요.</div>
      #endif

      #for(tong in tongs):
        <div class="card">
          <div class="card row" style="border:none;box-shadow:none;padding:0;margin:0;align-items:flex-start;">
            <div class="tong-info">
              <h3>#(tong.title)</h3>
              <p class="meta"><b>#(tong.type)</b> · #(tong.category) · v#(tong.version) · #(tong.ageRating)</p>
              #if(tong.bundleURL != ""):
                <a class="preview-link" href="#(tong.bundleURL)" target="_blank">미리보기 ↗</a>
              #endif
            </div>
            <div class="actions">
              <form method="post" action="/admin/tongs/#(tong.id)/approve">
                <button class="btn btn-primary" type="submit">승인</button>
              </form>
            </div>
          </div>
          <form method="post" action="/admin/tongs/#(tong.id)/reject" class="reject-row" style="margin-top:14px;">
            <input name="reason" placeholder="반려 사유를 입력하세요" required>
            <button class="btn btn-danger" type="submit">반려</button>
          </form>
        </div>
      #endfor
    </main>
  </div>
</body>
</html>
