<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css">
<style>
  :root {
    --bg: #f2f4f6;
    --surface: #ffffff;
    --blue: #3182f6;
    --blue-dark: #2272eb;
    --blue-bg: #e8f3ff;
    --text: #191f28;
    --text-sub: #4e5968;
    --text-cap: #8b95a1;
    --border: #e5e8eb;
    --border-soft: #f2f4f6;
    --red: #f04452;
    --red-bg: #fdeced;
    --green: #2ba471;
    --green-bg: #e6f6ef;
    --radius-card: 20px;
    --radius-btn: 12px;
    --shadow: 0 2px 8px rgba(0, 23, 51, 0.04), 0 1px 2px rgba(0, 23, 51, 0.04);
    --shadow-pop: 0 8px 24px rgba(0, 23, 51, 0.12);
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0; padding: 0;
    font-family: "Pretendard Variable", Pretendard, -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--bg); color: var(--text);
    -webkit-font-smoothing: antialiased;
    letter-spacing: -0.01em;
  }
  a { color: var(--blue); text-decoration: none; }

  /* ===== App shell ===== */
  .app { display: flex; min-height: 100vh; }
  .sidebar {
    width: 232px; flex-shrink: 0; background: var(--surface);
    border-right: 1px solid var(--border);
    padding: 24px 16px; position: sticky; top: 0; height: 100vh;
  }
  .brand { display: flex; align-items: center; gap: 8px; padding: 8px 12px 20px; font-size: 18px; font-weight: 700; }
  .brand .logo { font-size: 22px; }
  .nav-item {
    display: flex; align-items: center; gap: 10px;
    padding: 11px 12px; border-radius: 12px; margin-bottom: 2px;
    color: var(--text-sub); font-size: 15px; font-weight: 600; cursor: pointer;
    transition: background 0.12s;
  }
  .nav-item:hover { background: var(--border-soft); color: var(--text); }
  .nav-item.active { background: var(--blue-bg); color: var(--blue); }
  .nav-item .ico { font-size: 17px; width: 20px; text-align: center; }

  .content { flex: 1; min-width: 0; padding: 40px 48px; max-width: 1180px; }
  .page-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
  .page-head h1 { font-size: 26px; font-weight: 700; margin: 0; }
  .page-head .sub { color: var(--text-cap); font-size: 14px; margin-top: 4px; }
  .crumb { color: var(--text-cap); font-size: 13px; margin-bottom: 6px; font-weight: 600; }
  .crumb b { color: var(--text-sub); }

  /* ===== Card ===== */
  .card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-card); padding: 20px 22px;
    margin-bottom: 14px; box-shadow: var(--shadow);
  }
  .card.row { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .card h3 { margin: 0 0 6px; font-size: 17px; font-weight: 700; }
  .meta { color: var(--text-cap); font-size: 13px; margin: 0; font-weight: 500; }
  .meta b { color: var(--text-sub); font-weight: 600; }

  /* ===== Buttons ===== */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    padding: 11px 18px; border-radius: var(--radius-btn); border: 1px solid transparent;
    font-family: inherit; font-size: 15px; font-weight: 600; cursor: pointer;
    transition: background 0.12s, opacity 0.12s; white-space: nowrap; line-height: 1;
  }
  .btn:active { opacity: 0.85; }
  .btn-primary { background: var(--blue); color: #fff; }
  .btn-primary:hover { background: var(--blue-dark); }
  .btn-success { background: var(--green); color: #fff; }
  .btn-danger { background: var(--red); color: #fff; }
  .btn-ghost { background: var(--border-soft); color: var(--text-sub); }
  .btn-ghost:hover { background: var(--border); }
  .btn-outline { background: var(--surface); color: var(--text-sub); border-color: var(--border); }
  .btn-outline:hover { background: var(--border-soft); }
  .btn-sm { padding: 8px 13px; font-size: 13px; border-radius: 10px; }

  /* ===== Inputs ===== */
  input, select, textarea {
    font-family: inherit; font-size: 15px; color: var(--text);
    padding: 11px 13px; border: 1px solid var(--border); border-radius: var(--radius-btn);
    background: var(--surface); outline: none; transition: border-color 0.12s, box-shadow 0.12s;
  }
  input:focus, select:focus, textarea:focus { border-color: var(--blue); box-shadow: 0 0 0 3px var(--blue-bg); }
  input::placeholder, textarea::placeholder { color: var(--text-cap); }

  /* ===== Badge ===== */
  .badge { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 8px; font-size: 12px; font-weight: 700; }
  .badge.published { background: var(--blue-bg); color: var(--blue); }
  .badge.draft { background: var(--border-soft); color: var(--text-cap); }

  /* ===== Empty state ===== */
  .empty {
    text-align: center; color: var(--text-cap); font-size: 15px; font-weight: 500;
    padding: 64px 16px; background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-card);
  }
  .empty .emoji { font-size: 40px; display: block; margin-bottom: 12px; opacity: 0.7; }

  @media (max-width: 820px) {
    .sidebar { display: none; }
    .content { padding: 24px 20px; }
  }
</style>
